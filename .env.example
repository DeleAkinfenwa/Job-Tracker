# Copy to .env (or export these) and adjust. Never commit real secrets.
# Generate a key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to use SQLite. Set to use PostgreSQL:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/job_tracker

JWT_ACCESS_MINUTES=60
# Websites allowed to call the API from the browser (the React frontend). Comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Resume agent (optional). Only the emails listed here can use it, and it uses your Anthropic credit.
# Sign up with that email BEFORE setting this: once it's set, nobody can register that email.
# AGENT_OWNER_EMAILS=you@example.com
# ANTHROPIC_API_KEY=sk-ant-...
# AGENT_MODEL=claude-sonnet-5-5
# AGENT_DAILY_RUN_LIMIT=25
# AGENT_DAILY_TOKEN_LIMIT=600000
# Use the free built-in fake model while trying it out locally:
# AGENT_PROVIDER=mock
